{
  "DbConfig": {
    "ConnectionString": "Host=localhost;Port=5432;Database=ssh_sec_monitorer;Username=postgres;Password=postgres",
    "MasterConnectionString": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "SshSecMonitorer",
    "Audience": "SshSecMonitorer",
    "LifetimeMinutes": 480
  },
  "Auth": {
    "CookieName": "ssm_session",
    "AllowHttp": false,
    "MinPasswordLength": 12
  },
  "Setup": {
    "AdminUserName": "",
    "AdminPassword": ""
  },
  "Ldap": {
    "Enabled": false,
    "Host": "",
    "Port": 636,
    "UseSsl": true,
    "UseStartTls": false,
    "TrustedCertificatesDirectory": "",
    "BindDn": "",
    "BindPassword": "",
    "SearchBase": "",
    "UserFilter": "(&(objectClass=user)(sAMAccountName={0}))",
    "UserGroupDn": "",
    "AdminGroupDn": "",
    "TimeoutSeconds": 10
  },
  "Mail": {
    "Enabled": false,
    "Host": "",
    "Port": 25,
    "Security": "Auto",
    "UseAuth": false,
    "UserName": "",
    "Password": "",
    "From": "monitorer@example.local",
    "Recipients": ""
  },
  "Monitoring": {
    "PollTickSeconds": 10,
    "DefaultPollIntervalSeconds": 60,
    "MaxParallelPolls": 8,
    "MaxPollsPerTick": 0,
    "SshTimeoutSeconds": 15,
    "MaxFileBytes": 10485760,
    "LocalAgentRoot": "/app/agents",
    "StaleAfterSeconds": 300,
    "CpuWarnPercent": 85,
    "CpuCriticalPercent": 95,
    "MemoryWarnPercent": 85,
    "MemoryCriticalPercent": 95,
    "DiskWarnPercent": 85,
    "DiskCriticalPercent": 95,
    "LiveCheckTickSeconds": 5,
    "CertWarnDays": 30,
    "CertCriticalDays": 7,
    "AlertTickSeconds": 30,
    "MissingContainerStatus": "Warning",
    "KnownContainerIgnore": ""
  },
  "DataProtection": {
    "KeyPath": "keys"
  },
  "Localization": {
    "DefaultLanguage": "en"
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "FluentMigrator.Runner.MigrationRunner": "Error",
        "Monitorer": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
