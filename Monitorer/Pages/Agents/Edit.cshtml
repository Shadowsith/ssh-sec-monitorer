@page "{id:int?}"
@model Monitorer.Pages.Agents.EditModel
@{
    ViewData["Title"] = Model.IsNew ? L["agents.add"] : L["agents.edit"];
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>@L["common.back"]</a>
</div>
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
}
@if (Model.Credentials.Count == 0)
{
    <div class="alert alert-warning" data-show-for="Ssh">
        @L["agents.noCredentials"] <a asp-page="/SshCredentials/Edit" class="alert-link">@L["agents.noCredentialsLink"]</a>
        @L["agents.noCredentialsLocal"]
    </div>
}
<form method="post" class="card shadow-sm" data-connection-form>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.Name" class="form-label">@L["common.name"]</label>
                <input asp-for="Input.Name" class="form-control" required maxlength="100" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Description" class="form-label">@L["common.description"]</label>
                <input asp-for="Input.Description" class="form-control" maxlength="500" />
            </div>
            <div class="col-12">
                <span class="form-label d-block">@L["agents.connection"]</span>
                <div class="btn-group" role="group" aria-label="@L["agents.connectionType"]">
                    <input type="radio" class="btn-check" name="Input.ConnectionType" id="conn-ssh" value="@AgentConnectionTypes.Ssh"
                           autocomplete="off" data-connection-type checked="@(Model.IsSsh)" />
                    <label class="btn btn-outline-primary" for="conn-ssh"><i class="bi bi-hdd-network me-1"></i>@L["agents.connectionSsh"]</label>
                    <input type="radio" class="btn-check" name="Input.ConnectionType" id="conn-local" value="@AgentConnectionTypes.Local"
                           autocomplete="off" data-connection-type checked="@(!Model.IsSsh)" />
                    <label class="btn btn-outline-primary" for="conn-local"><i class="bi bi-house-door me-1"></i>@L["agents.connectionLocal"]</label>
                </div>
            </div>

            <!-- Local agent: only the folder name below Monitoring:LocalAgentRoot -->
            <div class="col-md-6" data-show-for="Local">
                <label asp-for="Input.LocalDir" class="form-label">@L["agents.localDir"]</label>
                <input asp-for="Input.LocalDir" class="form-control font-monospace" required pattern="[a-z0-9][a-z0-9_\-]{0,62}"
                       maxlength="63" placeholder="local" />
                <div class="form-text">
                    @L["agents.localDirHintRead"] <code>@Model.LocalAgentRoot/&lt;@L["agents.localDirPlaceholder"]&gt;/monitoring.json</code> @L["agents.localDirHintMount"]
                    @L["agents.localDirHintCompose"] <code>docker compose --profile local-agent up -d</code>: <code>local</code>.
                </div>
            </div>

            <!-- Remote VM via SFTP -->
            <div class="col-md-8" data-show-for="Ssh">
                <label asp-for="Input.Host" class="form-label">@L["agents.host"]</label>
                <input asp-for="Input.Host" class="form-control" required placeholder="vm-web-01.intern" />
            </div>
            <div class="col-md-4" data-show-for="Ssh">
                <label asp-for="Input.Port" class="form-label">@L["agents.sshPort"]</label>
                <input asp-for="Input.Port" type="number" min="1" max="65535" class="form-control" required />
            </div>
            <div class="col-md-6" data-show-for="Ssh">
                <label asp-for="Input.SshCredentialId" class="form-label">@L["agents.sshCredential"]</label>
                <select asp-for="Input.SshCredentialId" asp-items="Model.Credentials" class="form-select" required>
                    <option value="">@L["common.pleaseChoose"]</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.PollIntervalSeconds" class="form-label">@L["agents.pollInterval"]</label>
                <input asp-for="Input.PollIntervalSeconds" type="number" min="10" max="86400" class="form-control" required />
            </div>
            <div class="col-12" data-show-for="Ssh">
                <label asp-for="Input.RemotePath" class="form-label">@L["agents.remotePath"]</label>
                <input asp-for="Input.RemotePath" class="form-control font-monospace" required />
                <div class="form-text">@L["agents.remotePathHint1"] <code>AGENT_DATA_DIR</code> + <code>/monitoring.json</code>.
                    @L["agents.remotePathHint2"] <code>/agent/monitoring.json</code>.</div>
            </div>
            <div class="col-12" data-show-for="Ssh">
                <label asp-for="Input.HostKeyFingerprint" class="form-label">@L["agents.hostKey"]</label>
                <input asp-for="Input.HostKeyFingerprint" class="form-control font-monospace" placeholder="@L["agents.hostKeyPlaceholder"]" />
                <div class="form-text">@L["agents.hostKeyHint"]</div>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="Input.Enabled" class="form-check-input" role="switch" />
                    <label asp-for="Input.Enabled" class="form-check-label">@L["agents.enabled"]</label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@L["common.save"]</button>
        @if (!Model.IsNew)
        {
            <button type="submit" class="btn btn-outline-warning" asp-page-handler="ResetHostKey" data-show-for="Ssh" formnovalidate
                    data-confirm="@L["agents.resetHostKeyConfirm"]"><i class="bi bi-key me-1"></i>@L["agents.resetHostKey"]</button>
            <button type="submit" class="btn btn-outline-danger ms-auto" asp-page-handler="Delete" formnovalidate
                    data-confirm="@L["agents.deleteConfirm"]"><i class="bi bi-trash me-1"></i>@L["common.delete"]</button>
        }
    </div>
</form>

@section Scripts {
    <script src="~/js/agent-edit.js" asp-append-version="true"></script>
}
