@page
@model IndexModel
@{
    ViewData["Title"] = L["nav.overview"];
}
<div data-live="agents livechecks alerts">
    <h1 class="h3 mb-3">@L["nav.overview"]</h1>

    <div class="d-flex flex-wrap gap-3 mb-4">
        <partial name="_SummaryTile" model='(L["status.ok"].Value, Model.CountByStatus(MonitorStatus.Ok, MonitorStatus.Up), "success", "bi-check-circle")' />
        <partial name="_SummaryTile" model='(L["status.warning"].Value, Model.CountByStatus(MonitorStatus.Warning, MonitorStatus.Degraded), "warning", "bi-exclamation-triangle")' />
        <partial name="_SummaryTile" model='(L["status.critical"].Value, Model.CountByStatus(MonitorStatus.Critical), "danger", "bi-x-octagon")' />
        <partial name="_SummaryTile" model='(L["status.unreachable"].Value, Model.CountByStatus(MonitorStatus.Unreachable, MonitorStatus.Down), "danger", "bi-plug")' />
        <partial name="_SummaryTile" model='(L["overview.activeAlerts"].Value, Model.ActiveAlerts, Model.ActiveAlerts > 0 ? "danger" : "secondary", "bi-bell")' />
    </div>

    @if (Model.Overview.Agents.Count == 0 && Model.Overview.LiveChecks.Count == 0)
    {
        <div class="alert alert-info">
            @L["overview.empty"]
            @if (User.IsAdmin())
            {
                <a asp-page="/Agents/Edit" class="alert-link">@L["agents.add"]</a>
            }
        </div>
    }

    <div class="row g-3">
        <div class="col-12 col-xl-4">
            <partial name="_ChartCard" model='(L["overview.chartStatus"].Value, "chart-status", L["overview.chartStatusHint"].Value, "/Agents/Index")' />
        </div>
        <div class="col-12 col-xl-8">
            <partial name="_ChartCard" model='(L["overview.chartUsage"].Value, "chart-usage", L["overview.chartUsageHint"].Value, "/Agents/Index")' />
        </div>
        <div class="col-12 col-xl-6">
            <partial name="_ChartCard" model='(L["overview.chartCpu"].Value, "chart-cpu-history", L["overview.chartCpuHint"].Value, "/Agents/Index")' />
        </div>
        <div class="col-12 col-xl-6">
            <partial name="_ChartCard" model='(L["overview.chartMemory"].Value, "chart-memory-history", L["overview.chartMemoryHint"].Value, "/Agents/Index")' />
        </div>
        <div class="col-12 col-xl-6">
            <partial name="_ChartCard" model='(L["overview.chartContainers"].Value, "chart-containers", L["overview.chartContainersHint"].Value, "/Docker/Index")' />
        </div>
        <div class="col-12 col-xl-6">
            <partial name="_ChartCard" model='(L["overview.chartLiveChecks"].Value, "chart-live-checks", L["overview.chartLiveChecksHint"].Value, "/LiveChecks/Index")' />
        </div>
    </div>

    <script type="application/json" id="overview-data">@Html.Raw(Model.ChartsJson)</script>
</div>

@section Scripts {
    <script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/overview.js" asp-append-version="true"></script>
}
