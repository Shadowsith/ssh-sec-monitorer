@page
@model LoginModel
@{
    ViewData["Title"] = "Anmelden";
}
<div class="card shadow-sm card-narrow w-100">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <i class="bi bi-shield-lock-fill display-5 text-info"></i>
            <h1 class="h4 mt-2 mb-0">SshSecMonitorer</h1>
            <p class="text-body-secondary small mb-0">@(Model.LdapEnabled ? "Anmeldung mit Domänenkonto oder lokalem Konto" : "Bitte anmelden")</p>
        </div>
        <partial name="_Messages" />
        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
        }
        <form method="post" class="d-flex flex-column gap-3">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="form-floating">
                <input asp-for="Input.UserName" class="form-control" placeholder="Benutzername" autocomplete="username" autofocus required />
                <label asp-for="Input.UserName">Benutzername</label>
            </div>
            <div class="form-floating">
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Passwort" autocomplete="current-password" required />
                <label asp-for="Input.Password">Passwort</label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-box-arrow-in-right me-1"></i>Anmelden</button>
        </form>
    </div>
</div>
