@page "{id:int?}"
@model Monitorer.Pages.Alerts.EditModel
@{
    ViewData["Title"] = Model.IsNew ? L["alerts.add"] : L["alerts.edit"];
    var agentScenarios = string.Join(",", AlertScenarios.All.Where(AlertScenarios.UsesAgent));
    var containerScenarios = string.Join(",", AlertScenarios.All.Where(AlertScenarios.UsesContainerPattern));
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left me-1"></i>@L["common.back"]</a>
</div>
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
}
<form method="post" class="card shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.Name" class="form-label">@L["common.name"]</label>
                <input asp-for="Input.Name" class="form-control" required maxlength="100" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Scenario" class="form-label">@L["alerts.scenarioLabel"]</label>
                <select asp-for="Input.Scenario" class="form-select" data-toggle-group="scenario">
                    @foreach (var scenario in AlertScenarios.All)
                    {
                        <option value="@scenario">@L[AlertScenarios.NameKey(scenario)]</option>
                    }
                </select>
            </div>
            @foreach (var scenario in AlertScenarios.All)
            {
                <div class="col-12" data-show-for="scenario" data-show-value="@scenario">
                    <div class="form-text mt-0"><i class="bi bi-info-circle me-1"></i>@L[AlertScenarios.DescriptionKey(scenario)]</div>
                </div>
            }

            <div class="col-12"><hr class="my-1" /><div class="fw-semibold">@L["alerts.appliesTo"]</div></div>
            <div class="col-md-6" data-show-for="scenario" data-show-value="@agentScenarios">
                <label asp-for="Input.AgentId" class="form-label">@L["alerts.agent"]</label>
                <select asp-for="Input.AgentId" asp-items="Model.Agents" class="form-select">
                    <option value="">@L["alerts.allVmsOption"]</option>
                </select>
            </div>
            <div class="col-md-6" data-show-for="scenario" data-show-value="@AlertScenarios.LiveCheckDown">
                <label asp-for="Input.LiveCheckId" class="form-label">@L["alerts.liveCheck"]</label>
                <select asp-for="Input.LiveCheckId" asp-items="Model.LiveChecks" class="form-select">
                    <option value="">@L["alerts.allLiveChecksOption"]</option>
                </select>
            </div>
            <div class="col-md-6" data-show-for="scenario" data-show-value="@AlertScenarios.CertExpiring">
                <label asp-for="Input.CertCheckId" class="form-label">@L["alerts.certCheck"]</label>
                <select asp-for="Input.CertCheckId" asp-items="Model.CertChecks" class="form-select">
                    <option value="">@L["alerts.allCertChecksOption"]</option>
                </select>
            </div>
            <div class="col-md-6" data-show-for="scenario" data-show-value="@AlertScenarios.CertExpiring">
                <label asp-for="Input.ThresholdDays" class="form-label">@L["alerts.thresholdDays"]</label>
                <input asp-for="Input.ThresholdDays" type="number" min="1" max="365" class="form-control" />
                <div class="form-text">@L["alerts.thresholdDaysHint"]</div>
            </div>
            <div class="col-md-6" data-show-for="scenario" data-show-value="@containerScenarios">
                <label asp-for="Input.ContainerPattern" class="form-label">@L["alerts.containerPattern"]</label>
                <input asp-for="Input.ContainerPattern" class="form-control font-monospace" placeholder="@L["alerts.containerPatternPlaceholder"]" />
            </div>
            <div class="col-md-6" data-show-for="scenario" data-show-value="@AlertScenarios.AgentStale">
                <label asp-for="Input.ThresholdMinutes" class="form-label">@L["alerts.threshold"]</label>
                <input asp-for="Input.ThresholdMinutes" type="number" min="1" max="10080" class="form-control" />
                <div class="form-text">@L["alerts.thresholdHint"]</div>
            </div>
            <div class="col-md-6" data-show-for="scenario" data-show-value="@AlertScenarios.AgentStatus">
                <label asp-for="Input.MinStatus" class="form-label">@L["alerts.minStatus"]</label>
                <select asp-for="Input.MinStatus" class="form-select">
                    <option value="@MonitorStatus.Warning">@L["status.warning"]</option>
                    <option value="@MonitorStatus.Critical">@L["status.critical"]</option>
                </select>
            </div>
            <div class="col-12" data-show-for="scenario" data-show-value="@AlertScenarios.ContainerDown">
                <div class="form-check form-switch">
                    <input asp-for="Input.IgnoreCleanExit" class="form-check-input" role="switch" />
                    <label asp-for="Input.IgnoreCleanExit" class="form-check-label">@L["alerts.ignoreCleanExit"]</label>
                </div>
            </div>

            <div class="col-12"><hr class="my-1" /><div class="fw-semibold">@L["alerts.notification"]</div></div>
            <div class="col-sm-6 col-lg-3">
                <label asp-for="Input.DelayMinutes" class="form-label">@L["alerts.delay"]</label>
                <input asp-for="Input.DelayMinutes" type="number" min="0" max="1440" class="form-control" required />
                <div class="form-text">@L["alerts.delayHint"]</div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label asp-for="Input.RepeatMinutes" class="form-label">@L["alerts.repeat"]</label>
                <input asp-for="Input.RepeatMinutes" type="number" min="0" max="10080" class="form-control" required />
                <div class="form-text">@L["alerts.repeatHint"]</div>
            </div>
            <div class="col-lg-6">
                <label asp-for="Input.Recipients" class="form-label">@L["alerts.recipients"]</label>
                <input asp-for="Input.Recipients" class="form-control" placeholder="@L["alerts.recipientsPlaceholder"]" />
            </div>
            <div class="col-12 d-flex flex-wrap gap-4">
                <div class="form-check form-switch">
                    <input asp-for="Input.NotifyRecovery" class="form-check-input" role="switch" />
                    <label asp-for="Input.NotifyRecovery" class="form-check-label">@L["alerts.notifyRecovery"]</label>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="Input.Enabled" class="form-check-input" role="switch" />
                    <label asp-for="Input.Enabled" class="form-check-label">@L["alerts.ruleEnabled"]</label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@L["common.save"]</button>
        @if (!Model.IsNew)
        {
            <button type="submit" class="btn btn-outline-danger ms-auto" asp-page-handler="Delete" formnovalidate
                    data-confirm="@L["alerts.deleteConfirm"]"><i class="bi bi-trash me-1"></i>@L["common.delete"]</button>
        }
    </div>
</form>
