@page
@model Monitorer.Pages.Alerts.IndexModel
@{
    ViewData["Title"] = "Alarme";
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">Alarme</h1>
    <a class="btn btn-primary" asp-page="Edit"><i class="bi bi-plus-lg me-1"></i>Regel hinzufügen</a>
</div>

@if (!Model.MailReady)
{
    <div class="alert alert-warning">
        <i class="bi bi-envelope-exclamation me-2"></i>Der Mailversand ist nicht aktiviert. Alarme werden erkannt und hier angezeigt,
        aber nicht versendet. SMTP wird über <code>MAIL_*</code> in der <code>.env</code> (bzw. <code>Mail:*</code>) eingerichtet.
    </div>
}
else
{
    <div class="text-body-secondary small mb-3">
        <i class="bi bi-envelope-check me-1"></i>SMTP: <code>@Model.Mail.Host:@Model.Mail.Port</code> (@(Model.Mail.Security + (Model.Mail.UseAuth ? ", mit Anmeldung" : ", ohne Anmeldung")))
        · Standard-Empfänger: @(string.IsNullOrWhiteSpace(Model.Mail.Recipients) ? "keine" : Model.Mail.Recipients)
    </div>
}

<div data-live="alerts">
<h2 class="h5 mb-3"><i class="bi bi-bell-fill me-2 text-danger"></i>Aktive Alarme</h2>
<div class="card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr><th>Betroffen</th><th>Regel</th><th>Meldung</th><th>Seit</th><th>Mails</th><th>Nächste Mail</th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model.Active)
            {
                <tr>
                    <td class="fw-semibold">@a.State.SubjectName</td>
                    <td>@a.RuleName<div class="small text-body-secondary">@AlertScenarios.DisplayName(a.Scenario)</div></td>
                    <td class="small cell-wide">@a.State.Message</td>
                    <td title="@a.State.FirstDetectedAt.ToBerlinString("dd.MM.yyyy HH:mm:ss")">@(((DateTime?)a.State.FirstDetectedAt).ToAgeString())</td>
                    <td>
                        @if (a.IsPending)
                        {
                            <span class="badge text-bg-light border">wartet (Verzögerung)</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">@a.State.SendCount gesendet</span>
                        }
                    </td>
                    <td class="small">@(a.NextMailAt is null ? "keine (einmalig)" : a.NextMailAt.ToBerlinString("dd.MM. HH:mm"))</td>
                </tr>
            }
            @if (Model.Active.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-body-secondary py-4"><i class="bi bi-check-circle me-1"></i>Keine aktiven Alarme.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
</div>

<h2 class="h5 mb-3"><i class="bi bi-sliders me-2"></i>Regeln</h2>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>Regel</th><th>Szenario</th><th>Gilt für</th><th class="text-end">Verzögerung</th>
                <th class="text-end">Wiederholung</th><th>Entwarnung</th><th>Empfänger</th><th>Aktiv</th><th class="text-end">Aktionen</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rules)
            {
                <tr class="@(r.Enabled ? "" : "text-body-secondary")">
                    <td class="fw-semibold">
                        @r.Name
                        @if (r.ActiveCount > 0)
                        {
                            <span class="badge text-bg-danger ms-1" title="aktive Alarme">@r.ActiveCount</span>
                        }
                    </td>
                    <td>@(r.ScenarioName + (r.ThresholdMinutes is null ? "" : $" (> {r.ThresholdMinutes} min)") + (r.MinStatus is null ? "" : $" (ab {r.MinStatus})"))</td>
                    <td>@r.ScopeText</td>
                    <td class="text-end">@(r.DelayMinutes == 0 ? "sofort" : $"{r.DelayMinutes} min")</td>
                    <td class="text-end">@(r.RepeatMinutes == 0 ? "einmalig" : $"alle {r.RepeatMinutes} min")</td>
                    <td>@(r.NotifyRecovery ? "ja" : "nein")</td>
                    <td class="small">@(string.IsNullOrWhiteSpace(r.Recipients) ? "Standard" : r.Recipients)</td>
                    <td>
                        <form method="post" asp-page-handler="Toggle" asp-route-id="@r.Id" asp-route-enabled="@(!r.Enabled)" class="m-0">
                            <button type="submit" class="btn btn-sm @(r.Enabled ? "btn-success" : "btn-outline-secondary")"
                                    title="@(r.Enabled ? "Deaktivieren" : "Aktivieren")">@(r.Enabled ? "an" : "aus")</button>
                        </form>
                    </td>
                    <td class="text-end text-nowrap">
                        <form method="post" asp-page-handler="Test" asp-route-id="@r.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Testmail senden"><i class="bi bi-send"></i></button>
                        </form>
                        <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@r.Id" title="Bearbeiten"><i class="bi bi-pencil"></i></a>
                    </td>
                </tr>
            }
            @if (Model.Rules.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-body-secondary py-4">Keine Regeln angelegt.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="small text-body-secondary mt-3 mb-0">
    Ablauf: Ein Zustand wird erkannt → nach der <strong>Verzögerung</strong> geht die erste Mail raus → solange er anhält, alle
    <strong>Wiederholung</strong> Minuten eine Erinnerung → ist er behoben, kommt (wenn aktiviert) eine <strong>Entwarnung</strong>.
    <br />Ist eine VM nicht erreichbar, kommt nur der VM-Alarm; meldet sich ihr Agent nicht, nur dieser Alarm. Status- und Container-Alarme dieser VM
    ruhen solange – ohne Erinnerung und ohne Entwarnung – und laufen weiter, sobald wieder aktuelle Daten da sind.
</p>
