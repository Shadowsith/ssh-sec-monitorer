@page
@model Monitorer.Pages.Alerts.IndexModel
@{
    ViewData["Title"] = L["nav.alerts"];
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">@L["nav.alerts"]</h1>
    <a class="btn btn-primary" asp-page="Edit"><i class="bi bi-plus-lg me-1"></i>@L["alerts.addRule"]</a>
</div>

@if (!Model.MailReady)
{
    <div class="alert alert-warning">
        <i class="bi bi-envelope-exclamation me-2"></i>@L["alerts.mailDisabled"]
        @L["alerts.mailDisabledSetup"] <code>MAIL_*</code> (.env) / <code>Mail:*</code>.
    </div>
}
else
{
    <div class="text-body-secondary small mb-3">
        <i class="bi bi-envelope-check me-1"></i>SMTP: <code>@Model.Mail.Host:@Model.Mail.Port</code> (@(Model.Mail.Security + ", " + (Model.Mail.UseAuth ? L["alerts.withAuth"] : L["alerts.withoutAuth"])))
        · @L["alerts.defaultRecipients"] @(string.IsNullOrWhiteSpace(Model.Mail.Recipients) ? L["alerts.none"] : Model.Mail.Recipients)
    </div>
}

<div data-live="alerts">
<h2 class="h5 mb-3"><i class="bi bi-bell-fill me-2 text-danger"></i>@L["overview.activeAlerts"]</h2>
<div class="card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr><th>@L["alerts.subject"]</th><th>@L["alerts.rule"]</th><th>@L["liveChecks.message"]</th><th>@L["alerts.since"]</th><th>@L["alerts.mails"]</th><th>@L["alerts.nextMail"]</th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model.Active)
            {
                <tr>
                    <td class="fw-semibold">@a.State.SubjectName</td>
                    <td>@a.RuleName<div class="small text-body-secondary">@L[AlertScenarios.NameKey(a.Scenario)]</div></td>
                    <td class="small cell-wide">@a.State.Message</td>
                    <td title="@a.State.FirstDetectedAt.ToBerlinString(L, "format.dateTimeSeconds")">@(((DateTime?)a.State.FirstDetectedAt).ToAgeString(L))</td>
                    <td>
                        @if (a.IsPending)
                        {
                            <span class="badge text-bg-light border">@L["alerts.pending"]</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">@L["alerts.sentCount", a.State.SendCount]</span>
                        }
                    </td>
                    <td class="small">@(a.NextMailAt is null ? L["alerts.noNextMail"] : a.NextMailAt.ToBerlinString(L, "format.dayMonthTime"))</td>
                </tr>
            }
            @if (Model.Active.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-body-secondary py-4"><i class="bi bi-check-circle me-1"></i>@L["alerts.noActive"]</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
</div>

<h2 class="h5 mb-3"><i class="bi bi-sliders me-2"></i>@L["alerts.rules"]</h2>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>@L["alerts.rule"]</th><th>@L["alerts.scenario"]</th><th>@L["alerts.appliesTo"]</th><th class="text-end">@L["alerts.delayColumn"]</th>
                <th class="text-end">@L["alerts.repeatColumn"]</th><th>@L["alerts.recoveryColumn"]</th><th>@L["alerts.recipients"]</th><th>@L["common.enabled"]</th><th class="text-end">@L["common.actions"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rules)
            {
                <tr class="@(r.Enabled ? "" : "text-body-secondary")">
                    <td class="fw-semibold">
                        @r.Name
                        @if (r.ActiveCount > 0)
                        {
                            <span class="badge text-bg-danger ms-1" title="@L["overview.activeAlerts"]">@r.ActiveCount</span>
                        }
                    </td>
                    <td>@(r.ScenarioName + (r.ThresholdMinutes is null ? "" : $" (> {r.ThresholdMinutes} min)") + (r.MinStatus is null ? "" : " " + L["alerts.fromStatus", L[MonitorStatus.TextKey(r.MinStatus)]]))</td>
                    <td>@r.ScopeText</td>
                    <td class="text-end">@(r.DelayMinutes == 0 ? L["alerts.immediately"] : $"{r.DelayMinutes} min")</td>
                    <td class="text-end">@(r.RepeatMinutes == 0 ? L["alerts.once"] : L["alerts.everyMinutes", r.RepeatMinutes])</td>
                    <td>@(r.NotifyRecovery ? L["common.yes"] : L["common.no"])</td>
                    <td class="small">@(string.IsNullOrWhiteSpace(r.Recipients) ? L["alerts.default"] : r.Recipients)</td>
                    <td>
                        <form method="post" asp-page-handler="Toggle" asp-route-id="@r.Id" asp-route-enabled="@(!r.Enabled)" class="m-0">
                            <button type="submit" class="btn btn-sm @(r.Enabled ? "btn-success" : "btn-outline-secondary")"
                                    title="@(r.Enabled ? L["common.disable"] : L["common.enable"])">@(r.Enabled ? L["common.on"] : L["common.off"])</button>
                        </form>
                    </td>
                    <td class="text-end text-nowrap">
                        <form method="post" asp-page-handler="Test" asp-route-id="@r.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary" title="@L["alerts.sendTest"]"><i class="bi bi-send"></i></button>
                        </form>
                        <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@r.Id" title="@L["common.edit"]"><i class="bi bi-pencil"></i></a>
                    </td>
                </tr>
            }
            @if (Model.Rules.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-body-secondary py-4">@L["alerts.noRules"]</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="small text-body-secondary mt-3 mb-0">
    @L["alerts.flowHint"]
    <br />@L["alerts.suppressionHint"]
</p>
