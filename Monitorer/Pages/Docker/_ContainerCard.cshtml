@model ContainerDto
@inject Microsoft.Extensions.Options.IOptions<MonitoringSettings> Options
@{
    var s = Options.Value;
    var memDetail = Model.Memory?.Usage is null ? null : $"{Model.Memory.Usage.ToByteString()} / {Model.Memory.Limit.ToByteString()}";
}
<div class="col" data-container-card data-running="@(Model.IsRunning ? "true" : "false")">
    <div class="card h-100 shadow-sm agent-card border-@Model.StateCssClass">
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <h3 class="h6 mb-0 text-truncate" title="@Model.Name">@Model.Name</h3>
                <span class="badge text-bg-@Model.StateCssClass">@Model.StateText</span>
            </div>
            <code class="small text-truncate d-block mb-3" title="@Model.Image">@Model.Image</code>
            @if (Model.IsRunning)
            {
                <partial name="_UsageBar" model='new UsageBarDto("CPU", Model.CpuPercent, null, s.CpuWarnPercent, s.CpuCriticalPercent)' />
                <partial name="_UsageBar" model='new UsageBarDto("RAM", Model.Memory?.Percent, memDetail, s.MemoryWarnPercent, s.MemoryCriticalPercent)' />
            }
            @if (Model.IsRunning && Model.BlockIo is { } io)
            {
                <partial name="_BlockIo" model="io" />
            }
            @if (Model.Ports is { } ports)
            {
                <partial name="_PortList" model="ports" />
            }
            <div class="d-flex flex-wrap justify-content-between gap-2 small text-body-secondary mt-auto pt-2">
                <span>@(Model.IsRunning ? L["containers.runningSince", Model.StartedAtUtc.ToSinceString(L)] : L["containers.exitCode", Model.ExitCode?.ToString() ?? "–"])</span>
                <span>@L["containers.restarts", Model.RestartCount ?? 0]</span>
            </div>
            @if (Model.Logs is { } logs)
            {
                <div class="d-flex gap-1 mt-2">
                    <span class="badge text-bg-@(logs.ErrorCount > 0 ? "danger" : "light")">@L["containers.errors", logs.ErrorCount]</span>
                    <span class="badge text-bg-@(logs.WarningCount > 0 ? "warning" : "light")">@L["containers.warnings", logs.WarningCount]</span>
                </div>
            }
        </div>
    </div>
</div>
