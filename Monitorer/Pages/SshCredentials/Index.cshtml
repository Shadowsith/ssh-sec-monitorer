@page
@model Monitorer.Pages.SshCredentials.IndexModel
@{
    ViewData["Title"] = L["nav.sshCredentials"];
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">@L["nav.sshCredentials"]</h1>
    <a class="btn btn-primary" asp-page="Edit"><i class="bi bi-plus-lg me-1"></i>@L["credentials.add"]</a>
</div>
<p class="text-body-secondary">
    @L["credentials.intro"]
</p>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr><th>@L["common.name"]</th><th>@L["credentials.userName"]</th><th>@L["credentials.auth"]</th><th class="text-end">@L["nav.agents"]</th><th>@L["common.changed"]</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Credentials)
            {
                <tr>
                    <td class="fw-semibold">@c.Name</td>
                    <td><code>@c.UserName</code></td>
                    <td>
                        @if (c.AuthType == SshAuthTypes.Key)
                        {
                            <span class="badge text-bg-info"><i class="bi bi-key me-1"></i>@L["credentials.authKey"]</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary"><i class="bi bi-asterisk me-1"></i>@L["user.password"]</span>
                        }
                    </td>
                    <td class="text-end">@c.UsedByAgents</td>
                    <td>@c.UpdatedAt.ToBerlinString(L)</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@c.Id" title="@L["common.edit"]"><i class="bi bi-pencil"></i></a></td>
                </tr>
            }
            @if (Model.Credentials.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-body-secondary py-4">@L["credentials.empty"]</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
