@page
@model ErrorModel
@{
    ViewData["Title"] = L[Model.TitleKey];
}
<div class="card shadow-sm mx-auto card-narrow">
    <div class="card-body text-center p-5">
        <div class="display-5 text-body-secondary mb-3">@(Model.Code?.ToString() ?? "500")</div>
        <h1 class="h4">@L[Model.TitleKey]</h1>
        <a class="btn btn-primary mt-3" asp-page="/Index"><i class="bi bi-house me-1"></i>@L["error.toOverview"]</a>
    </div>
</div>
