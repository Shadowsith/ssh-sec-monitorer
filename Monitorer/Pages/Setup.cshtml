@page
@model SetupModel
@{
    ViewData["Title"] = L["setup.title"];
}
<div class="card shadow-sm card-narrow w-100">
    <div class="card-body p-4 p-md-5">
        <h1 class="h4"><i class="bi bi-gear me-2"></i>@L["setup.title"]</h1>
        <p class="text-body-secondary">@L["setup.intro"]</p>
        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }
        <form method="post" class="d-flex flex-column gap-3">
            <div>
                <label asp-for="Input.UserName" class="form-label">@L["user.userName"]</label>
                <input asp-for="Input.UserName" class="form-control" autocomplete="username" required />
            </div>
            <div>
                <label asp-for="Input.DisplayName" class="form-label">@L["user.displayName"]</label>
                <input asp-for="Input.DisplayName" class="form-control" />
            </div>
            <div>
                <label asp-for="Input.Password" class="form-label">@L["user.password"]</label>
                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" minlength="@Model.MinPasswordLength" required />
                <div class="form-text">@L["user.passwordMinLength", Model.MinPasswordLength]</div>
            </div>
            <div>
                <label asp-for="Input.PasswordRepeat" class="form-label">@L["user.passwordRepeat"]</label>
                <input asp-for="Input.PasswordRepeat" type="password" class="form-control" autocomplete="new-password" required />
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>@L["setup.submit"]</button>
        </form>
    </div>
</div>
