@inject Microsoft.Extensions.Options.IOptions<SwaggerSettings> SwaggerOptions
@functions {
    private string Active(string prefix) =>
        (ViewContext.RouteData.Values["page"] as string)?.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) == true
            ? "active" : "link-body-emphasis";
}
<nav class="offcanvas-lg offcanvas-start sidebar border-end bg-body" tabindex="-1" id="sidebar" aria-labelledby="sidebar-label">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="sidebar-label">@L["nav.title"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="@L["common.close"]"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-2 pt-lg-3">
        <ul class="nav nav-pills flex-column gap-1">
            <li class="nav-item"><a class="nav-link @Active("/Index")" asp-page="/Index"><i class="bi bi-speedometer2 me-2"></i>@L["nav.overview"]</a></li>
            <li class="nav-item"><a class="nav-link @Active("/Agents/")" asp-page="/Agents/Index"><i class="bi bi-hdd-network me-2"></i>@L["nav.agents"]</a></li>
            <li class="nav-item"><a class="nav-link @Active("/Docker/")" asp-page="/Docker/Index"><i class="bi bi-boxes me-2"></i>Docker</a></li>
            <li class="nav-item"><a class="nav-link @Active("/LiveChecks/")" asp-page="/LiveChecks/Index"><i class="bi bi-activity me-2"></i>@L["nav.liveChecks"]</a></li>
            <li class="nav-item"><a class="nav-link @Active("/CertChecks/")" asp-page="/CertChecks/Index"><i class="bi bi-shield-lock me-2"></i>@L["nav.certChecks"]</a></li>
            <li class="nav-item"><a class="nav-link @Active("/CveChecks/")" asp-page="/CveChecks/Index"><i class="bi bi-bug me-2"></i>@L["nav.cveChecks"]</a></li>
        </ul>
        @if (User.IsAdmin())
        {
            <div class="text-body-secondary small text-uppercase fw-semibold px-3 mt-4 mb-1">@L["nav.administration"]</div>
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item"><a class="nav-link @Active("/Alerts/")" asp-page="/Alerts/Index"><i class="bi bi-bell me-2"></i>@L["nav.alerts"]</a></li>
                <li class="nav-item"><a class="nav-link @Active("/SshCredentials/")" asp-page="/SshCredentials/Index"><i class="bi bi-key me-2"></i>@L["nav.sshCredentials"]</a></li>
                <li class="nav-item"><a class="nav-link @Active("/Users/")" asp-page="/Users/Index"><i class="bi bi-people me-2"></i>@L["nav.users"]</a></li>
                @if (SwaggerOptions.Value.Enabled)
                {
                    <li class="nav-item"><a class="nav-link link-body-emphasis" href="~/swagger" target="_blank" rel="noopener"><i class="bi bi-braces me-2"></i>API</a></li>
                }
            </ul>
        }
    </div>
</nav>
