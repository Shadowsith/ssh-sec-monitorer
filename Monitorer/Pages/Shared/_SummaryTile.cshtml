@model (string Label, int Count, string Color, string Icon)
<div class="card shadow-sm flex-fill summary-tile border-start border-4 border-@Model.Color">
    <div class="card-body d-flex align-items-center gap-3 py-3">
        <i class="bi @Model.Icon fs-3 text-@Model.Color"></i>
        <div>
            <div class="fs-4 fw-semibold lh-1">@Model.Count</div>
            <div class="small text-body-secondary">@Model.Label</div>
        </div>
    </div>
</div>
