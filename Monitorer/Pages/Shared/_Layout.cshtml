<!DOCTYPE html>
<html lang="de" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · SshSecMonitorer</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body class="d-flex flex-column min-vh-100 bg-body-tertiary">
@if (User.Identity?.IsAuthenticated == true)
{
    <header class="navbar bg-dark sticky-top flex-nowrap py-2 shadow-sm" data-bs-theme="dark">
        <div class="container-fluid gap-2">
            <button class="navbar-toggler d-lg-none border-0" type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Navigation öffnen">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand d-flex align-items-center gap-2 me-auto" asp-page="/Index">
                <i class="bi bi-shield-lock-fill text-info"></i><span>SshSecMonitorer</span>
                <small class="text-body-secondary fs-6 fw-normal">v@(typeof(Program).Assembly.GetName().Version?.ToString(3))</small>
            </a>
            <div class="d-flex align-items-center gap-2 text-light">
                <span class="small px-2 d-none" role="status" data-live-status><i class="bi bi-broadcast me-1"></i><span>Live</span></span>
                <button type="button" class="btn btn-sm btn-outline-light" data-theme-toggle title="Hell / Dunkel">
                    <i class="bi bi-circle-half"></i>
                </button>
                <span class="d-none d-md-inline small px-2"><i class="bi bi-person-circle me-1"></i>@User.GetDisplayName()</span>
                <form method="post" asp-page="/Logout" class="m-0">
                    <button class="btn btn-sm btn-outline-light" type="submit" title="Abmelden">
                        <i class="bi bi-box-arrow-right"></i><span class="d-none d-sm-inline ms-1">Abmelden</span>
                    </button>
                </form>
            </div>
        </div>
    </header>
    <div class="d-flex flex-grow-1">
        <partial name="_Navigation" />
        <main class="flex-grow-1 min-w-0 p-3 p-lg-4">
            <partial name="_Messages" />
            @RenderBody()
        </main>
    </div>
}
else
{
    <main class="flex-grow-1 d-flex align-items-center justify-content-center p-3">
        @RenderBody()
    </main>
}
<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (User.Identity?.IsAuthenticated == true)
{
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/live.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
