@model string
@{
    var icon = Model switch
    {
        MonitorStatus.Ok or MonitorStatus.Up => "bi-check-circle",
        MonitorStatus.Degraded => "bi-exclamation-circle",
        MonitorStatus.Warning => "bi-exclamation-triangle",
        MonitorStatus.Critical => "bi-x-octagon",
        MonitorStatus.Unreachable => "bi-plug",
        MonitorStatus.Down => "bi-x-circle",
        "Disabled" => "bi-pause-circle",
        _ => "bi-question-circle"
    };
    var text = L[MonitorStatus.TextKey(Model)];
}
<span class="badge text-bg-@MonitorStatus.CssClass(Model)"><i class="bi @icon me-1"></i>@text</span>
