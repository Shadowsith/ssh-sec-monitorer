@model ContainerBlockIoDto
@if (!Model.Available)
{
    <div class="small text-body-secondary mb-2" title="@L["blockIo.unavailableHint"]">@L["blockIo.unavailable"]</div>
}
else
{
    <div class="small mb-2">
        <div class="d-flex justify-content-between gap-2">
            <span class="text-body-secondary"><i class="bi bi-device-hdd me-1"></i>Disk I/O</span>
            <span class="text-nowrap">
                <span title="@L["blockIo.read"]"><i class="bi bi-arrow-down-short"></i>@Model.ReadBps.ToRateString()</span>
                <span class="ms-1" title="@L["blockIo.write"]"><i class="bi bi-arrow-up-short"></i>@Model.WriteBps.ToRateString()</span>
            </span>
        </div>
        @if (Model.HasTotals)
        {
            <div class="text-body-secondary text-end" title="@L["blockIo.totalHint"]">
                @L["blockIo.total", Model.ReadTotal.ToByteString(), Model.WriteTotal.ToByteString()]
            </div>
        }
    </div>
}
