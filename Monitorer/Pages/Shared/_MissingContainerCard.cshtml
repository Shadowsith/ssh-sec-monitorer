@model KnownContainerDb
@{
    var returnPage = ViewData["ForgetPage"] as string ?? "/Docker/Index";
}
<div class="col" data-container-card data-running="false">
    <div class="card h-100 container-missing border-secondary border-dashed">
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <h3 class="h6 mb-0 text-truncate text-decoration-line-through" title="@Model.Name">@Model.Name</h3>
                <span class="badge text-bg-secondary"><i class="bi bi-question-circle me-1"></i>nicht mehr vorhanden</span>
            </div>
            <code class="small text-truncate d-block mb-3" title="@Model.Image">@Model.Image</code>
            <dl class="row small mb-0">
                <dt class="col-6 fw-normal text-body-secondary">Zuletzt gesehen</dt>
                <dd class="col-6 mb-1 text-end" title="@Model.LastSeenAt.ToBerlinString("dd.MM.yyyy HH:mm:ss")">@(((DateTime?)Model.LastSeenAt).ToAgeString())</dd>
                <dt class="col-6 fw-normal text-body-secondary">Letzter Status</dt>
                <dd class="col-6 mb-1 text-end">@(Model.LastState ?? "–")</dd>
                <dt class="col-6 fw-normal text-body-secondary">Zuerst gesehen</dt>
                <dd class="col-6 mb-0 text-end">@Model.FirstSeenAt.ToBerlinString("dd.MM.yyyy")</dd>
            </dl>
            @if (User.IsAdmin())
            {
                <form method="post" asp-page="@returnPage" asp-page-handler="Forget" asp-route-knownId="@Model.Id"
                      asp-route-id="@ViewData["AgentId"]" class="mt-auto pt-3">
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100"
                            data-confirm="Container @Model.Name endgültig aus der Übersicht entfernen?">
                        <i class="bi bi-trash me-1"></i>Endgültig entfernen
                    </button>
                </form>
            }
        </div>
    </div>
</div>
