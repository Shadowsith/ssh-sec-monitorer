<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Configurator.ViewModels"
        xmlns:db="using:Configurator.Data.Db"
        xmlns:i18n="using:Configurator.Localization"
        x:Class="Configurator.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{i18n:T window.title}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{i18n:T toolbar.new}" Command="{Binding NewCommand}" />
                <Button Content="{i18n:T toolbar.save}" Command="{Binding SaveCommand}" Classes="accent" />
                <Button Content="{i18n:T toolbar.duplicate}" Command="{Binding DuplicateCommand}" IsEnabled="{Binding IsSaved}" />
                <Button Content="{i18n:T toolbar.delete}" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsSaved}" />
                <Border Width="1" Margin="6,2" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Button Content="{i18n:T toolbar.copyYaml}" Click="OnCopyYaml" />
                <Button Content="{i18n:T toolbar.exportYaml}" Click="OnExportYaml" />
                <Button Content="{i18n:T toolbar.importYaml}" Click="OnImportYaml" />
            </StackPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding StatusMessage}" />
                <TextBlock Text="{Binding ValidationMessage}" Foreground="OrangeRed" TextWrapping="Wrap"
                           IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="260,5,*,5,480">
            <!-- saved configurations -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{i18n:T list.title}" Margin="10,10,10,6" FontWeight="SemiBold" />
                <ListBox ItemsSource="{Binding Configs}" SelectedItem="{Binding SelectedConfig}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="db:AgentConfigDb">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Classes="hint" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <!-- editor -->
            <ScrollViewer Grid.Column="2">
                <StackPanel Margin="16" Spacing="12">
                    <Expander Header="{i18n:T section.config}">
                        <StackPanel Spacing="8">
                            <DockPanel><TextBlock Classes="label" Text="{i18n:T config.name}" /><TextBox Text="{Binding ConfigName}" Watermark="{i18n:T config.nameWatermark}" /></DockPanel>
                            <DockPanel><TextBlock Classes="label" Text="{i18n:T config.description}" /><TextBox Text="{Binding ConfigDescription}" /></DockPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{i18n:T section.agent}">
                        <StackPanel Spacing="8">
                            <DockPanel><TextBlock Classes="label" Text="{i18n:T agent.name}" /><TextBox Text="{Binding Settings.Agent.Name}" /></DockPanel>
                            <DockPanel><TextBlock Classes="label" Text="{i18n:T agent.outputFile}" /><TextBox Text="{Binding Settings.Agent.OutputFile}" /></DockPanel>
                            <DockPanel><TextBlock Classes="label" Text="{i18n:T agent.outputFileMode}" /><TextBox Text="{Binding Settings.Agent.OutputFileMode}" Width="180" HorizontalAlignment="Left" /></DockPanel>
                            <DockPanel><TextBlock Classes="label" Text="{i18n:T agent.writeInterval}" /><NumericUpDown Value="{Binding Settings.Agent.WriteInterval}" Minimum="1" Maximum="86400" /></DockPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{i18n:T section.host}">
                        <StackPanel Spacing="8">
                            <CheckBox Content="{i18n:T host.enabled}" IsChecked="{Binding Settings.Host.Enabled}" />
                            <StackPanel Spacing="8" IsEnabled="{Binding Settings.Host.Enabled}">
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T common.readInterval}" /><NumericUpDown Value="{Binding Settings.Host.Interval}" Minimum="1" Maximum="86400" /></DockPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T common.historyRetention}" /><NumericUpDown Value="{Binding Settings.Host.HistoryRetention}" Minimum="0" Maximum="604800" Increment="300" /></DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox Content="CPU" IsChecked="{Binding Settings.Host.Cpu}" />
                                    <CheckBox Content="{i18n:T host.memory}" IsChecked="{Binding Settings.Host.Memory}" />
                                    <CheckBox Content="Load" IsChecked="{Binding Settings.Host.Load}" />
                                    <CheckBox Content="{i18n:T host.disks}" IsChecked="{Binding Settings.Host.Disks.Enabled}" />
                                    <CheckBox Content="{i18n:T host.network}" IsChecked="{Binding Settings.Host.Network.Enabled}" />
                                </StackPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T host.mounts}" /><TextBox Text="{Binding DiskMounts}" Watermark="{i18n:T host.mountsWatermark}" /></DockPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T host.interfaces}" /><TextBox Text="{Binding NetworkInterfaces}" Watermark="{i18n:T host.interfacesWatermark}" /></DockPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T host.interfacesExclude}" /><TextBox Text="{Binding NetworkExclude}" Watermark="{i18n:T host.interfacesExcludeWatermark}" /></DockPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T host.procPath}" /><TextBox Text="{Binding Settings.Host.ProcPath}" /></DockPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T host.rootfsPath}" /><TextBox Text="{Binding Settings.Host.RootfsPath}" /></DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{i18n:T section.docker}">
                        <StackPanel Spacing="8">
                            <CheckBox Content="{i18n:T docker.enabled}" IsChecked="{Binding Settings.Docker.Enabled}" />
                            <StackPanel Spacing="8" IsEnabled="{Binding Settings.Docker.Enabled}">
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.baseUrl}" /><TextBox Text="{Binding Settings.Docker.BaseUrl}" /></DockPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T common.readInterval}" /><NumericUpDown Value="{Binding Settings.Docker.Interval}" Minimum="1" Maximum="86400" /></DockPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.timeout}" /><NumericUpDown Value="{Binding Settings.Docker.Timeout}" Minimum="1" Maximum="300" /></DockPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.maxWorkers}" /><NumericUpDown Value="{Binding Settings.Docker.MaxWorkers}" Minimum="1" Maximum="32" /></DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox Content="{i18n:T docker.stats}" IsChecked="{Binding Settings.Docker.Stats}" />
                                    <CheckBox Content="{i18n:T docker.history}" IsChecked="{Binding Settings.Docker.History}" />
                                </StackPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T common.historyRetention}" /><NumericUpDown Value="{Binding Settings.Docker.HistoryRetention}" Minimum="0" Maximum="604800" Increment="300" /></DockPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.include}" /><TextBox Text="{Binding DockerInclude}" Watermark="{i18n:T docker.includeWatermark}" /></DockPanel>
                                <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.exclude}" /><TextBox Text="{Binding DockerExclude}" Watermark="{i18n:T docker.excludeWatermark}" /></DockPanel>

                                <TextBlock Text="Ports" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <CheckBox Content="{i18n:T docker.ports}" IsChecked="{Binding Settings.Docker.Ports.Enabled}" />
                                <CheckBox Content="{i18n:T docker.portsLocalhost}" IsChecked="{Binding Settings.Docker.Ports.IncludeLocalhost}"
                                          IsEnabled="{Binding Settings.Docker.Ports.Enabled}" Margin="24,0,0,0" />

                                <TextBlock Text="Disk I/O" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <CheckBox Content="{i18n:T docker.blockIo}" IsChecked="{Binding Settings.Docker.BlockIo.Enabled}" />
                                <CheckBox Content="{i18n:T docker.blockIoTotals}" IsChecked="{Binding Settings.Docker.BlockIo.Totals}"
                                          IsEnabled="{Binding Settings.Docker.BlockIo.Enabled}" Margin="24,0,0,0" />

                                <TextBlock Text="Logs" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <CheckBox Content="{i18n:T docker.logs}" IsChecked="{Binding Settings.Docker.Logs.Enabled}" />
                                <StackPanel Spacing="8" IsEnabled="{Binding Settings.Docker.Logs.Enabled}">
                                    <DockPanel><TextBlock Classes="label" Text="{i18n:T common.readInterval}" /><NumericUpDown Value="{Binding Settings.Docker.Logs.Interval}" Minimum="1" Maximum="86400" /></DockPanel>
                                    <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.logsWindow}" /><NumericUpDown Value="{Binding Settings.Docker.Logs.Window}" Minimum="1" Maximum="86400" /></DockPanel>
                                    <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.logsTail}" /><NumericUpDown Value="{Binding Settings.Docker.Logs.TailLines}" Minimum="0" Maximum="500" /></DockPanel>
                                    <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.logsMaxScan}" /><NumericUpDown Value="{Binding Settings.Docker.Logs.MaxScanLines}" Minimum="1" Maximum="100000" Increment="100" /></DockPanel>
                                    <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.logsMaxLength}" /><NumericUpDown Value="{Binding Settings.Docker.Logs.MaxLineLength}" Minimum="20" Maximum="10000" Increment="50" /></DockPanel>
                                    <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.logsErrorPattern}" /><TextBox Text="{Binding Settings.Docker.Logs.ErrorPattern}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" /></DockPanel>
                                    <DockPanel><TextBlock Classes="label" Text="{i18n:T docker.logsWarningPattern}" /><TextBox Text="{Binding Settings.Docker.Logs.WarningPattern}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" /></DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

            <!-- YAML preview -->
            <DockPanel Grid.Column="4" Margin="0,0,10,10">
                <TextBlock DockPanel.Dock="Top" Text="{i18n:T preview.title}" Margin="0,10,0,6" FontWeight="SemiBold" />
                <TextBox Text="{Binding YamlPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
