# Copy to .env (or run ./setup.sh) and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=ssm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ssh_sec_monitorer

# --- Monitorer ---
# at least 32 characters
JWT_KEY=change-me-to-a-long-random-value-0123456789
JWT_LIFETIME_MINUTES=480
# false = HTTPS required (reverse proxy in front); true = also allow plain HTTP (tests / trusted LAN only)
MONITORER_ALLOW_HTTP=false
# 127.0.0.1 = only reachable via a local reverse proxy; 0.0.0.0 = all interfaces
MONITORER_BIND=127.0.0.1
MONITORER_PORT=8080
SWAGGER_ENABLED=false
# UI language when the browser asks for none of the supported ones, and language of alert mails: en | de
DEFAULT_LANGUAGE=en

# Initial admin (only used if no user exists yet; without LDAP an admin is required).
# Leave empty to create the admin on the setup page instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- SMTP warning mails ---
MAIL_ENABLED=false
MAIL_HOST=smtp.example.local
MAIL_PORT=587
# None | StartTls | SslOnConnect | Auto
MAIL_SECURITY=StartTls
MAIL_USE_AUTH=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=monitorer@example.local
# separated by ;
MAIL_RECIPIENTS=admin@example.local

# --- optional LDAP / AD ---
LDAP_ENABLED=false
LDAP_HOST=dc01.example.local
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_USE_STARTTLS=false
# directory with trusted CA certificates inside the container, e.g. Assets/Certs
LDAP_CERT_DIR=
LDAP_BIND_DN=CN=svc-monitorer,OU=Service,DC=example,DC=local
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=DC=example,DC=local
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={0}))
LDAP_USER_GROUP_DN=CN=Monitoring-Users,OU=Groups,DC=example,DC=local
LDAP_ADMIN_GROUP_DN=CN=Monitoring-Admins,OU=Groups,DC=example,DC=local

# --- monitoring defaults ---
POLL_INTERVAL_SECONDS=60
# load handling: fetches are spread over each agent's interval automatically;
# at most this many SFTP fetches at the same time / started per 10 s tick (0 = no limit)
MAX_PARALLEL_POLLS=8
MAX_POLLS_PER_TICK=0
STALE_AFTER_SECONDS=300
# status for containers that were seen once and are gone now: Warning | Critical | None
MISSING_CONTAINER_STATUS=Warning
# never remember these containers (wildcards, separated by ;), e.g. short-lived CI jobs
KNOWN_CONTAINER_IGNORE=
# e.g. KNOWN_CONTAINER_IGNORE=build-job-*;*-tmp
